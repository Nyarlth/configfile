listview {
    scrollbar: false;
    dynamic: true;
    spacing: 6px;
}

element {
    padding: 10px 15px;
    border-radius: 6px;
    background-color: @base01;
    text-color: @base05;
    children: [element-icon, element-text];
    spacing: 12px;
}
*/
/* ... 其他全局设置 ... */

listview {
    scrollbar: false;
    dynamic: true;
    spacing: 6px;
    layout: vertical;
    columns: 5;
    lines: 3;
    flow: horizontal;
}

element {
    padding: 10px 15px;
    border-radius: 6px;
    background-color: @base01;
    text-color: @base05;
    children: [element-icon, element-text];
    spacing: 6px;
    orientation: vertical;
}

/* ... 其他设置保持不变 ... */
element selected {
    background-color: @base0D;
    text-color: @base00;
}

element alternate {
    background-color: @base02;
}

element-text {
  font: "Fira Code 15";
    text-color: inherit;
}

element-icon {
    size: 1.2em;
}

mode-switcher {
    border: 0;
    spacing: 6px;
}

button {
    padding: 8px 12px;
    border-radius: 6px;
    background-color: @base03;
    text-color: @base05;
    margin: 0 3px;
}

button selected {
    background-color: @base0D;
    text-color: @base00;
    font-weight: bold;
}

message {
    padding: 8px 12px;
    background-color: @base01;
    border-radius: 6px;
    text-color: @base05;
}

/* State colors */
element normal urgent, button urgent {
    background-color: @base08;
    text-color: @base00;
}

element normal active, button active {
    background-color: @base0B;
    text-color: @base00;
}
