/*
 * Light ROFI Theme - Seamless Design
 */

* {
    /* Light color palette */
    base00: #FAFAFA;  /* Background */
    base01: #0000001C;  /* Slightly darker background */
    base01shadow: #E5E5E51C;  /* Slightly darker background */
    base02: #0000001C;  /* Element separator */
    base03: #E0E0E0;  /* Button background */
    base04: #BDBDBD;  /* Secondary text */
    base05: #757575;  /* Primary text */
    base06: #616161;  /* Highlight text */
    base07: #212121;  /* Strong text */
    
    /* Accent colors */
    base08: #FF5252;  /* Error/urgent */
    base09: #FF9800;  /* Warning */
    base0A: #FFC107;  /* Highlight */
    base0B: #4CAF50;  /* Success */
    base0C: #00BCD4;  /* Info */
    base0D: #2196F3;  /* Primary action */
    base0E: #9C27B0;  /* Special */
    base0F: #607D8B;  /* Muted */

    spacing: 2px;
    background-color: transparent;
}

window {
    transparency: "real";
    background-color: @base00DD;  /* Slight transparency */
    width:1000px;
    blur: true;
    blur-radius: 15px;
    blur-sigma: 30;
    blur-noise: 0.05;
    padding: 20px;
}

mainbox {
    children: [inputbar, listview];
    spacing: 12px;
    padding: 20px;
    border: 0;
}

inputbar {
    margin: 0px 20px 20px;
    padding: 10px;

    children: [prompt, textbox-prompt-colon, entry];
    background-color: @base01shadow;
    border-radius: 20 50;
    height: 40px;
    shadow: 5 1 1 3;
    shadow-color:@base01shadow;
}

prompt {
    text-color: @base0D;
    margin: 0 8px 0 20px;
}

textbox-prompt-colon {
    expand: false;
    str: "›";
    text-color: @base0D;
    margin: 0 5px 0 0;
}

entry {
    text-color: @base0D;
    font: inherit;
}
